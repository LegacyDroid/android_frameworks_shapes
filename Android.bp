android_library {
    name: "LiquidGlassShapes",
    srcs: ["shapes/src/main/kotlin/**/*.kt"],
    platform_apis: true,
    manifest: "AndroidManifest.xml",

    static_libs: [
        "liquidglass-compose-runtime",
        "liquidglass-compose-ui",
        "liquidglass-compose-ui-util",
    ],

    kotlincflags: [
        "-opt-in=androidx.compose.runtime.ExperimentalComposeApi",
    ],
}
